PORT=8787
HOST=127.0.0.1
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_here
# OPTIONAL first-run seed only. Normally leave this empty and add symbols from the dashboard search box;
# the list is then saved in backend/data/watchlist.json (that file wins once it exists).
# Format: SYMBOL:TOKEN,SYMBOL:TOKEN
# Instrument master (symbol search + option chains). Two Angel One URLs are tried automatically. If both fail (HTTP 404, firewall),
# download OpenAPIScripMaster.json in a browser, then set SCRIP_MASTER_FILE to its path (or SCRIP_MASTER_URL to a working link).
SCRIP_MASTER_FILE=
SCRIP_MASTER_URL=
WATCHLIST=
WATCHLIST_MAX=20

# Candle size in minutes: 1, 3, 5, 10, 15, 30 or 60
TIMEFRAME=5
RSI_PERIOD=14
RSI_BUY_MIN=50
RSI_BUY_MAX=85
RSI_EXIT_LEVEL=45

# --- Historical backfill ---
BACKFILL_ENABLED=true
# Earlier candles loaded as RSI warm-up (today's full session is always loaded for VWAP)
HISTORY_CANDLES=50
# Calendar days to look back (covers weekends / holidays)
BACKFILL_LOOKBACK_DAYS=7
# NSE indices report no volume -> use average typical price instead of a volume-weighted VWAP
VWAP_FALLBACK=true

# --- Optional BUY continuation (already above VWAP, not a fresh cross) ---
ENABLE_CONTINUATION=true
CONTINUATION_MIN_CANDLES=2
CONTINUATION_MAX_DIST_PCT=0.5

# ===== Confirmation phases: mode = off | advisory | required =====
# required = a FAIL vetoes the BUY. advisory = shown and counted, never vetoes. NA (unmeasurable data) never vetoes.
# Phase 02 - EMA
EMA_MODE=required
EMA_FAST=9
EMA_SLOW=21
# Phase 03 - Volume (index tokens report no volume -> shown as NA)
VOLUME_MODE=required
VOLUME_LOOKBACK=20
VOLUME_MIN_RVOL=1.2
# Phase 04 - MACD
MACD_MODE=required
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MACD_REQUIRE_ZERO=false
ATR_PERIOD=14
# Phases 05/06 - Option chain, OI + PCR (needs NFO options for the watchlist symbol, e.g. NIFTY, BANKNIFTY)
OPTION_CHAIN_ENABLED=true
OPTION_MODE=advisory
OI_MODE=advisory
OPTION_EXPIRY=nearest
OPTION_STRIKES_EACH_SIDE=10
OPTION_POLL_SECONDS=60
OPTION_MIN_ROOM_PCT=0.3
PCR_BULLISH=1.0
PCR_BEARISH=0.7
OI_COMPARE_MINUTES=30
OI_MIN_BASELINE_MINUTES=5
# Phase 07 - AI. Regime filter is local. The Claude review is optional and advisory only.
AI_MODE=advisory
AI_REVIEW_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_REVIEW_ON_BUY=true
AI_MIN_GAP_SECONDS=60
# Phase 08 - Risk engine (model account; no orders are placed)
RISK_ENABLED=true
RISK_CAPITAL=500000
RISK_PER_TRADE_PCT=1
RISK_ATR_STOP_MULT=1.5
RISK_MIN_STOP_PCT=0.15
RISK_MAX_STOP_PCT=2
RISK_REWARD=2
RISK_TRAIL_START_R=1
RISK_TRAIL_MULT=1
RISK_MAX_DAILY_LOSS_PCT=3
RISK_MAX_TRADES_PER_DAY=3
RISK_MAX_OPEN=2
RISK_COOLDOWN_CANDLES=2
RISK_NO_ENTRY_BEFORE=09:20
RISK_NO_ENTRY_AFTER=14:45
RISK_SQUARE_OFF=15:15

# --- Cloud deployment (set these in the hosting dashboard, NOT in a file you upload) ---
# HOST=0.0.0.0 is needed on any server; Render sets PORT itself. Locally leave HOST as 127.0.0.1.
# Login for the public dashboard (browser asks for this). Use a long, unique password.
APP_USERNAME=admin
APP_PASSWORD=
# Render free services sleep after 15 min; the app pings itself every 10 min to stay awake. Set false to disable.
KEEP_AWAKE=true
# Only if the frontend is hosted on a different domain (normally leave empty)
CORS_ORIGIN=
